# Copy to .env.test (default mode) or .env.production, and fill in values.
# BOT_ENV selects which file is loaded. It defaults to "test" so a local run
# can never touch production by accident. Set BOT_ENV=production explicitly.
# BOT_ENV=test

DISCORD_TOKEN=

# Optional: sync slash commands instantly to one guild (recommended for dev)
# GUILD_ID=123456789012345678
