# Copy to .env.test or .env.production and fill in the values locally.
# Set BOT_ENV=production explicitly when running the production bot.
# BOT_ENV=test
DISCORD_TOKEN=
# GUILD_ID=123456789012345678

# Docker defaults to /data/lifeguard.db.
# DATABASE_PATH=./data/lifeguard.db

# Leave GITHUB_APP_ID unset to run without the GitHub bridge.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PUBLIC_URL=https://lifeguard.example.com
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Generate a Fernet key once and back it up with your other secrets.
# TOKEN_ENCRYPTION_KEY=
